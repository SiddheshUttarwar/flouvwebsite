# Copy this file to backend/.env and fill in real values. backend/.env is
# gitignored and must never be committed.

# Gemini API key used for the RAG chatbot, report generation, and embeddings.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Google Drive folder ID to sync into the chatbot's knowledge base
# (requires backend/credentials.json — see drive_loader.py).
GOOGLE_DRIVE_FOLDER_ID=""

# Unused placeholder, kept for compatibility with existing deployments.
BOT_API_KEY=""

# Password required to log into /admin. Set a strong, unique value in
# production — this is the only credential gating blog/upload management.
ADMIN_PASSWORD="change-me"

# Gmail SMTP credentials used to email-notify on every new inquiry
# (contact form / "request this report" submissions). GMAIL_SMTP_USER is
# the Gmail address sending FROM; GMAIL_SMTP_APP_PASSWORD is an App
# Password, NOT the account's normal login password — the account needs
# 2-Step Verification enabled to generate one, at
# myaccount.google.com/apppasswords. Leave both unset to skip sending (the
# inquiry is still stored either way — this only affects the notification).
GMAIL_SMTP_USER=""
GMAIL_SMTP_APP_PASSWORD=""

# Where new-inquiry notification emails are sent. Defaults to
# pankajuttarwar@flouv.us if unset.
# INQUIRY_NOTIFY_EMAIL="pankajuttarwar@flouv.us"

# Separate Gmail SMTP account used ONLY for the newsletter batch send that
# fires when a new blog post is created (never on update/delete) — kept
# distinct from GMAIL_SMTP_USER above so bulk newsletter sends don't share a
# sending reputation/rate limit with transactional inquiry notifications.
# Same App-Password caveat as above: even if this account's regular login
# password matches GMAIL_SMTP_USER's account, Google issues a SEPARATE App
# Password per account — generate one for this account specifically at
# myaccount.google.com/apppasswords, it will NOT be the same string as
# GMAIL_SMTP_APP_PASSWORD. Leave unset to skip sending (subscribers are
# still recorded in the signups table either way).
NEWSLETTER_SMTP_USER=""
NEWSLETTER_SMTP_APP_PASSWORD=""

# Base URL used to build the "read this post" link in newsletter emails.
# Defaults to https://flouv.us if unset.
# SITE_BASE_URL="https://flouv.us"

# Comma-separated list of origins allowed to call the API with credentials.
# Only needed if the frontend is ever hosted on a different origin than the
# API (in production they're normally served together, same-origin).
# CORS_ORIGINS="https://your-prod-domain.com"

# Overrides the default local SQLite file
# (sqlite:///<repo>/backend/flouv.db). Set to a Postgres URL for local dev
# against a real Postgres instance, or in production (render.yaml wires this
# automatically to the managed Postgres database — you don't need to set it
# by hand on Render).
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Folder names (comma-separated, case-insensitive) never descended into
# during a Drive sync — the only thing standing between confidential/IP
# documents and a public chatbot that will quote whatever it's given. Has a
# sane default (see drive_loader.py) — only set this if the Drive folder
# structure changes. NEVER set it to an empty string in production; that
# means "exclude nothing."
# GOOGLE_DRIVE_EXCLUDE_FOLDER_NAMES="FloUV - Technology & IP,Client Presentations,Desgin and Engineering"

# On Render with an attached persistent disk, set this to the disk's mount
# path (e.g. "/var/data") so the vector store, embedding cache, KB sidecar,
# uploads, and Drive OAuth files (credentials.json/token.json) survive
# restarts/redeploys. Unset = local dev default (everything lives under
# backend/, wiped on a free-tier Render restart since there's no disk).
# PERSIST_DIR="/var/data"

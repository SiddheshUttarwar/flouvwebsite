# Local editor/tool config, not shared via GitHub
.claude/

# Python
__pycache__/
*.py[cod]
*$py.class
*.env
venv/
env/
.venv/

# Database
backend/flouv.db
/flouv.db

# RAG pipeline: persistent local state, not committed
backend/chroma_data/
backend/cache_data/
backend/kb_sidecar.json
# Generated by scripts/extract-site-content.mjs (npm run build) — derived
# from src/pages/*.jsx, regenerated on every build, not a source file.
backend/site_content/

# Node
node_modules/
dist/
dist-ssr/
*.local

# Locally-downloaded tool binaries (e.g. a platform-specific Node runtime) —
# never belongs in git regardless of what pulled it in.
.localtools/

# OS
.DS_Store
Thumbs.db

backend/credentials.json
backend/token.json

# Local machine-specific tool downloads (e.g. platform-specific Node binaries)
.localtools/
